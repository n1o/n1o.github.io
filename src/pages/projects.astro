---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../lib/projects";
---


<Base title="Projects · Marek Barak">
  <p class="section-label">02 / PROJECTS</p>
  <h1>Things I'm building</h1>
  <p class="intro">
    Things I build start with something that bothers me. Each card is a
    product that exists — why it exists, and where to find it.
  </p>
  <div class="grid">
    {
      projects.map((p) => (
        <ProjectCard
          href={p.href}
          category={p.category}
          name={p.name}
          claim={p.claim}
          pitch={p.pitch}
          tag={p.tag}
          cta={p.cta}
        />
      ))
    }
  </div>

</Base>

<style>
  .intro {
    color: var(--muted);
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    margin-bottom: 4rem;
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
