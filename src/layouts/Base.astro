---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = "AI Researcher · Product Builder — I turn ambiguous technical problems into working systems.",
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Apply persisted/system theme before first paint
      (() => {
        const stored = localStorage.getItem("theme");
        const light = stored
          ? stored === "light"
          : matchMedia("(prefers-color-scheme: light)").matches;
        document.documentElement.classList.toggle("light", light);
      })();
    </script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <script
      src="https://www.googletagmanager.com/gtag/js?id=G-5WLCXX3LGJ"
      async
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-5WLCXX3LGJ");
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">
          <span class="brand-name">MAREK BARAK</span>
          <span class="brand-tag">Researcher · Builder</span>
        </a>
        <nav>
          <a href="/projects/"><span class="nav-prompt">&gt;</span>Projects</a>
          <a href="/posts/"><span class="nav-prompt">&gt;</span>Writing</a>
          <a href="/research/"><span class="nav-prompt">&gt;</span>Research</a>
          <a href="/about/"><span class="nav-prompt">&gt;</span>About</a>
        </nav>
        <button
          class="theme-toggle"
          aria-label="Toggle light/dark theme"
          title="Toggle theme"
        >
          <span class="theme-icon-dark" aria-hidden="true">◐</span>
          <span class="theme-icon-light" aria-hidden="true">◑</span>
        </button>
      </div>
    </header>
    <main class={wide ? "wide" : ""}><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-left">
          <span class="footer-brand">MAREK BARAK</span>
          <span class="footer-motto">Build · Learn · Share</span>
        </div>
        <div class="socials">
          <a href="https://github.com/n1o">GitHub</a>
          <a href="https://twitter.com/n1o_cr0Tx">Twitter</a>
          <a
            href="https://www.linkedin.com/in/marek-bar%C3%A1k-31977a55/">LinkedIn</a
          >
          <a href="https://medium.com/@n1o_cr0Tx">Medium</a>
          <a href="https://dissecting-ai.dev">Dissecting AI</a>
          <a href="mailto:mrk.barak@gmail.com">Email</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    z-index: 10;
  }
  .site-header .wrap,
  .site-footer .wrap {
    width: min(var(--wide), 100% - 3rem);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .site-header .wrap {
    padding-block: 0.85rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    text-decoration: none;
  }
  .brand-name {
    font-weight: 700;
    color: var(--fg-strong);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
  .brand-tag {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
  }
  nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .nav-prompt {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .theme-toggle {
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.25rem 0.55rem;
    line-height: 1;
    cursor: pointer;
    color: var(--muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .theme-icon-dark,
  .theme-icon-light {
    font-size: 0.85rem;
  }
  .theme-icon-light {
    display: none;
  }
  :root.light .theme-icon-dark {
    display: none;
  }
  :root.light .theme-icon-light {
    display: inline;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.82rem;
    margin-top: 5rem;
  }
  .site-footer .wrap {
    padding-block: 1.2rem;
    flex-wrap: wrap;
    row-gap: 0.6rem;
  }
  .footer-left {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .footer-brand {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--fg);
  }
  .footer-motto {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .socials {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
  }
  .socials a {
    color: var(--muted);
  }
  .socials a:hover {
    color: var(--accent);
  }
</style>

<style>
  /* Ambient background — ported from Dissecting AI (codebreakers-re Layout.astro) */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom right,
      var(--ambient-from),
      var(--bg),
      var(--ambient-to)
    );
  }
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.15;
    background-image:
      linear-gradient(var(--ambient-grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--ambient-grid-line) 1px, transparent 1px);
    background-size: 50px 50px;
  }
  .site-header,
  main,
  .site-footer {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  // Theme toggle — mirrors Dissecting AI's dark/light switch behavior
  const toggle = document.querySelector(".theme-toggle");
  toggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const light = root.classList.toggle("light");
    localStorage.setItem("theme", light ? "light" : "dark");
  });
</script>
